{
	admin off
	auto_https off
}

:8081 {
	route {
		@unauthenticated not header Authorization "Bearer {$REVIEW_MCP_TOKEN}"
		respond @unauthenticated 401

		@execute {
			method POST
			path /review-mcp/api/exec
		}
		handle @execute {
			request_body {
				max_size 1MB
			}
			uri strip_prefix /review-mcp
			reverse_proxy 127.0.0.1:8080 {
				header_up -Authorization
			}
		}
		@execution {
			method GET
			path_regexp ^/review-mcp/api/executions/[A-Za-z0-9_-]+(/output)?$
		}
		handle @execution {
			uri strip_prefix /review-mcp
			reverse_proxy 127.0.0.1:8080 {
				header_up -Authorization
			}
		}
		respond 404
	}
}
